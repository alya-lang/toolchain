{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "alya-toolchain",
  "version": "1.0.0",
  "description": "Multi-platform minimal C and GNU Assembler toolchain suite for the Alya programming language",
  "platforms": {
